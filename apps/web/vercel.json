{
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "pnpm build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "kansou-web-dzqj.vercel.app" }],
      "destination": "https://kansou-log.com/:path*",
      "permanent": true
    }
  ]
}
